# Copy to .env and fill in. None are required to run tests or serve locally.

# Raises GitHub from 60 to 5,000 requests/hour. No scopes needed for public data.
GITHUB_TOKEN=

# Higher Semantic Scholar limits (free, request at semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Joins the OpenAlex "polite pool" — higher, more reliable limits
OPENALEX_MAILTO=you@example.com

# Set on the SERVING side: makes every /v1 route require a bearer token
RIP_API_TOKEN=

# Default sqlite:///seekr.db; set a postgresql+psycopg:// URL to scale out
RIP_DATABASE_URL=

# Discovery leads drained per nightly run
RIP_LEAD_BATCH=100

# TinyFish Search + Fetch. Free, no credits, no card. Get a key at
# https://agent.tinyfish.ai/api-keys — Seekr never calls Agent or Browser.
TINYFISH_API_KEY=
