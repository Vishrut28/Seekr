# Copy to .env and fill in. Nothing here is required to run tests or to serve
# locally — but read the first section before deploying anywhere real.
#
# In a container, pass these as environment variables instead. The process
# reads .env only if the file is present, and anything already in the
# environment wins, so a Kubernetes Secret always overrides a baked-in file.

# ── Serving ──────────────────────────────────────────────────────────────────

# Makes every /v1 route require `Authorization: Bearer <this>`.
# LEAVING THIS EMPTY SERVES PERSONAL DATA WITH NO AUTHENTICATION AT ALL.
# Generate one with: openssl rand -hex 32
RIP_API_TOKEN=

# Default is sqlite:///rip.db — a single file, which two processes cannot
# share. For anything with more than one replica, use Postgres:
#   postgresql+psycopg://user:password@host:5432/seekr
RIP_DATABASE_URL=

# ── Ingestion credentials ────────────────────────────────────────────────────
# All optional. Each one raises a rate limit or unlocks a source; none of them
# affect serving data that is already in the graph.

# Raises GitHub from 60 to 5,000 requests/hour. No scopes needed — public data
# only. github.com/settings/tokens/new, tick nothing.
GITHUB_TOKEN=

# Joins the OpenAlex "polite pool" — higher, more reliable limits. It is sent
# in every request URL, so use an address you are happy to publish, or leave it
# empty and stay on the anonymous pool. An address on example.com/.org/.net is
# treated as this placeholder and not sent.
OPENALEX_MAILTO=

# Higher Semantic Scholar limits (free, semanticscholar.org/product/api).
# Without it the API is rate-limited to the point of being unusable, and live
# search does not ask it about subjects ("soil microbiome"), only names.
SEMANTIC_SCHOLAR_API_KEY=

# Same-site pages the web connector may read besides the page it was given
# (About, CV, Publications, Research), each checked against robots.txt. 0 reads
# the one page only.
RIP_WEB_MAX_SUBPAGES=3

# Stack Exchange daily quota: 300/day without a key, 10,000 with.
STACKEXCHANGE_KEY=

# Exa — metered, and the only source that indexes non-academic professional
# profiles. Live search falls back to free sources when this is unset.
EXA_API_KEY=

# ── Web search, for `find-homepages` ─────────────────────────────────────────
# That command refuses to run unless at least one of these is set.

TAVILY_API_KEY=
SERPAPI_API_KEY=

# ── Fetch proxies, for sites that block direct requests ──────────────────────
# Optional. The web connector reads pages directly first and only falls back
# to a proxy when one is configured.

ZENROWS_API_KEY=
SCRAPINGBEE_API_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────────
# Sensible defaults; shown so they are discoverable rather than buried.

# Discovery leads drained per nightly run.
RIP_LEAD_BATCH=100

# How many filter matches get scored before the page is cut. Higher is more
# thorough and slower; ranking is CPU work in Python over this pool.
RIP_CANDIDATE_POOL=250

# Wall-clock budget, in seconds, for one live search's profile fetches. Fetches
# not started in time are skipped and reported, so one slow source cannot
# hold a search open.
RIP_LIVE_BUDGET_SECONDS=30

# Seconds the query vocabulary is cached per database. Raise it for a large,
# slow-changing corpus; lower it if freshly ingested people must be searchable
# immediately.
RIP_VOCAB_TTL=60

# Days a live-search result is replayed from cache before the provider is paid
# again. Short enough that job changes surface within a week.
SEEKR_SEARCH_TTL_DAYS=7

# Live sources to leave out of a search, comma-separated. Every source is on by
# default. Europe PMC, for instance, finds biomedical people no other free
# source can identify and adds a few seconds to a live search to do it — worth
# it for some graphs, not for others.
#   RIP_SKIP_SOURCES=europepmc
RIP_SKIP_SOURCES=
